post_extract() {
	vsrcextract -C source/MaterialXView/NanoGUI ${_nanogui_githash}.tar.gz
	vsrcextract -C source/MaterialXView/NanoGUI/ext/glfw ${_glfw_githash}.tar.gz
	vsrcextract -C source/MaterialXView/NanoGUI/ext/nanovg ${_nanovg_githash}.tar.gz
	vsrcextract -C source/MaterialXGraphEditor/External/ImGui ${_imgui_githash}.tar.gz
	vsrcextract -C source/MaterialXGraphEditor/External/ImGuiNodeEditor ${_imgui_node_editor_githash}.tar.gz
}

post_install() {
	vlicense LICENSE
	vlicense THIRD-PARTY.md
}

materialx-devel_package() {
	depends="${sourcepkg}>=${version}_${revision}
	  ${sourcepkg}-data>=${version}_${revision}
	  ${sourcepkg}-view>=${version}_${revision}
	  ${sourcepkg}-graph-editor>=${version}_${revision}
	  libXt-devel"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include
		vmove "usr/lib/*.so"
		vmove usr/lib/cmake
	}
}

materialx-data_package() {
	depends="${sourcepkg}>=${version}_${revision}"
	short_desc+=" - data files"
	pkg_install() {
		vmove usr/share/materialx
	}
}

materialx-view_package() {
	depends="${sourcepkg}>=${version}_${revision}"
	short_desc+=" - view app"
	pkg_install() {
		vmove usr/bin/MaterialXView
	}
}

materialx-graph-editor_package() {
	depends="${sourcepkg}>=${version}_${revision}"
	short_desc+=" - graph editor app"
	pkg_install() {
		vmove usr/bin/MaterialXGraphEditor
	}
}

materialx-python3_package() {
	depends="${sourcepkg}>=${version}_${revision}"
	short_desc+=" - Python3 bindings"
	pkg_install() {
		vmove usr/lib/python3.14/site-packages
	}
}
